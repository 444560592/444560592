/* pages/index/index.wxss */

.hero {
  background: linear-gradient(135deg, #1565C0 0%, #0288D1 100%);
  padding: 50rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #fff;
}

.greeting {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.hero-date {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-n {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.stat-n.warn     { color: #FFD54F; }
.stat-n.done-clr { color: #A5D6A7; }

.stat-l {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-sep {
  width: 2rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* Infusion banner */
.infusion-banner {
  margin: 20rpx 30rpx;
  background: linear-gradient(90deg, #00796B, #00ACC1);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  color: #fff;
}

.ib-icon {
  font-size: 48rpx;
  margin-right: 18rpx;
}

.ib-body { flex: 1; }

.ib-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.ib-bar-wrap {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  margin: 8rpx 0 4rpx;
}

.ib-bar-fill {
  height: 100%;
  background: #fff;
  border-radius: 4rpx;
  transition: width 0.5s;
}

.ib-remain {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
}

.ib-arrow {
  font-size: 48rpx;
  opacity: 0.7;
  margin-left: 10rpx;
}

/* Action grid */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 0 30rpx;
}

.ac {
  border-radius: 20rpx;
  padding: 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.ac.blue  { background: #1565C0; }
.ac.teal  { background: #00796B; }
.ac.amber { background: #E65100; }
.ac.red   { background: #C62828; }

.ac-icon  { font-size: 60rpx; }
.ac-lbl   { font-size: 28rpx; font-weight: 600; margin-top: 12rpx; }

/* Pending task list */
.p0 { padding: 0; }

.p-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.p-item:last-child { border-bottom: none; }

.p-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dot-red  { background: #E53935; }
.dot-blue { background: #1565C0; }

.p-body { flex: 1; }

.p-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #222;
}

.p-loc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.p-badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  margin-left: 12rpx;
}

.show-all {
  text-align: center;
  color: #1565C0;
  font-size: 26rpx;
  padding: 20rpx;
}
