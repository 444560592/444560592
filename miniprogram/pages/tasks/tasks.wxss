/* pages/tasks/tasks.wxss */

/* Filter tabs */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.f-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
}

.f-tab.active {
  color: #1565C0;
  border-color: #1565C0;
  font-weight: 600;
}

/* Task cards */
.task-list {
  padding: 20rpx 30rpx 220rpx;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 24rpx 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tc-check {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.tc-check.status-pending { background: #EEF2FF; color: #1565C0; }
.tc-check.status-doing   { background: #FFF8E1; color: #E65100; }
.tc-check.status-done    { background: #E8F5E9; color: #388E3C; }

.tc-body { flex: 1; }

.tc-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #222;
}

.tc-name.done-text {
  text-decoration: line-through;
  color: #aaa;
}

.tc-loc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.tc-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-top: 10rpx;
}

.tc-del {
  font-size: 36rpx;
  color: #ccc;
  padding: 4rpx 8rpx;
  flex-shrink: 0;
}

/* Clear done bar */
.clear-bar {
  position: fixed;
  bottom: 130rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 15;
}

.clear-btn {
  display: inline-block;
  background: #fff;
  border: 2rpx solid #E53935;
  color: #E53935;
  font-size: 26rpx;
  padding: 14rpx 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(229, 57, 53, 0.18);
}

/* FAB */
.fab {
  position: fixed;
  bottom: 170rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1565C0;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(21, 101, 192, 0.45);
  z-index: 20;
}

/* Mask */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 30;
}

/* Bottom sheet */
.bs {
  position: fixed;
  bottom: -100%;
  left: 0; right: 0;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 20rpx 30rpx 60rpx;
  z-index: 31;
  transition: bottom 0.3s ease;
  max-height: 90vh;
  overflow-y: auto;
}

.bs.bs-show { bottom: 0; }

.bs-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.bs-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.bs-title { font-size: 34rpx; font-weight: 700; color: #222; }
.bs-close { font-size: 36rpx; color: #999; padding: 8rpx 12rpx; }

/* Templates */
.tpl-toggle {
  background: #F0F4F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 16rpx;
  text-align: center;
}

.tpl-list {
  background: #F8FAFC;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tpl-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.tpl-item:last-child { border-bottom: none; }

.tpl-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.tpl-loc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* Form */
.form-row { margin-bottom: 28rpx; }

.form-lbl {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 12rpx;
}

.req { color: #E53935; }

.form-inp {
  width: 100%;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #F5F7FA;
}

/* Priority buttons */
.pri-row  { display: flex; gap: 16rpx; }

.pri-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.pri-btn.p-high { background: #FEE2E2; color: #C62828; }
.pri-btn.p-norm { background: #E3F2FD; color: #1565C0; }
.pri-btn.sel    { border-color: currentColor; font-weight: 600; }

/* Footer */
.bs-foot { margin-top: 30rpx; }

.confirm-btn {
  background: #1565C0;
  color: #fff;
  border-radius: 16rpx;
  text-align: center;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
}
